{
  "name": "GenieSim",
  "dockerComposeFile": "docker-compose.yml",
  "service": "geniesim",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  // entrypoint.sh gosu's down from root to a user remapped to HOST_UID/HOST_GID.
  // TODO: set this to that user's name once you've confirmed it (defaults to
  // the image's canned "isaac-sim" user, uid 1234, if HOST_UID isn't honored yet).
  "remoteUser": "isaac-sim",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-azuretools.vscode-docker",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "black-formatter.args": ["--line-length=120"]
      }
    }
  },

  "postCreateCommand": "echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc"
}
